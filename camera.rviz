Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 28; 28; 32
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: D435i colored depth
      Enabled: true
      Topic:
        Value: /camera/camera/depth/color/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Size (Pixels): 3
      Style: Points
      Color Transformer: RGB8
      Position Transformer: XYZ
      Queue Size: 3
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Image
      Name: RGB camera
      Enabled: true
      Topic:
        Value: /camera/camera/color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Normalize Range: true
      Min Value: 0
      Max Value: 1
    - Class: rviz_default_plugins/Image
      Name: Metric depth
      Enabled: true
      Topic:
        Value: /camera/camera/depth/image_rect_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Normalize Range: true
      Median window: 5
    - Class: rviz_default_plugins/TF
      Name: Camera frames
      Enabled: true
      Show Axes: true
      Show Names: false
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.6
      Pitch: 0.85
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Target Frame: world
Window Geometry:
  Width: 1400
  Height: 900
  X: 20
  Y: 30
